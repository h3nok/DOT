{
  "name": "dot-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "Personal site & portfolio workspace (frontend + backend orchestration)",
  "scripts": {
    "dev": "node runner.js",
    "dev:frontend": "pnpm --dir frontend dev",
    "dev:backend": "cd backend && python src/main.py",
    "build": "pnpm --dir frontend build",
    "preview": "pnpm --dir frontend preview",
    "lint": "pnpm --dir frontend lint",
    "typecheck": "pnpm --dir frontend typecheck",
    "install:frontend": "pnpm --dir frontend install",
    "install:backend": "cd backend && pip install -r requirements.txt"
  },
  "engines": {
    "node": ">=18"
  }
}
