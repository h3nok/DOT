# Backend API Configuration
# If you're running the backend locally on a different port:
# VITE_API_BASE_URL=http://localhost:8000/api

# FastAPI orchestrator used by profile/book delivery surfaces:
VITE_ORCHESTRATOR_URL=http://127.0.0.1:8000
VITE_ORCHESTRATOR_OWNER_ID=henok
VITE_PROFILE_DELIVERY_OWNER_ID=henok
VITE_PROFILE_DELIVERY_SLUG=henok-profile

# Support, while the orchestrator is not yet deployed (ADR-0012).
#
# The server plane owns prices and the ledger, so when the orchestrator is live
# leave this unset and support runs through /v1/support. Until then a hosted
# Stripe Payment Link keeps the work fundable on a static release: Stripe owns
# the amount and the receipt, and DOT stores nothing. Must be HTTPS.
# VITE_SUPPORT_PAYMENT_LINK=https://buy.stripe.com/your-payment-link

# If using the default (relative paths):
# VITE_API_BASE_URL=/api

# For production:
# VITE_API_BASE_URL=https://your-production-backend.com/api
