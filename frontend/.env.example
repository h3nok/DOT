# Backend API Configuration
# If you're running the backend locally on a different port:
# VITE_API_BASE_URL=http://localhost:8000/api

# FastAPI orchestrator used by profile/book delivery surfaces:
VITE_ORCHESTRATOR_URL=http://127.0.0.1:8000
VITE_ORCHESTRATOR_OWNER_ID=henok
VITE_PROFILE_DELIVERY_OWNER_ID=henok
VITE_PROFILE_DELIVERY_SLUG=henok-profile

# Support, while the orchestrator is not yet deployed (ADR-0012).
#
# The server plane owns prices and the ledger, so when the orchestrator is live
# leave this unset and support runs through /v1/support. Until then a hosted
# Stripe Payment Link keeps the work fundable on a static release: Stripe owns
# the amount and the receipt, and DOT stores nothing. Must be HTTPS.
# VITE_SUPPORT_PAYMENT_LINK=https://buy.stripe.com/your-payment-link

# Where a request to join lands, until the server-side invite queue exists
# (ADR-0003). A mailto: reaches the steward with no third party and no public
# list; a private HTTPS form endpoint works too. Never point this at a public
# issue tracker — that publishes who asked and why.
# VITE_JOIN_URL=mailto:you@example.com?subject=Asking%20to%20join%20DOT

# Aggregate readership (ADR-0024). L9 bans behavioural trackers, not counting:
# Plausible sets no cookie, stores nothing on the reader's device, and keeps no
# per-person record, so it can report how many read and never who. Set it to the
# bare hostname you registered with Plausible. Leave it unset and no third-party
# request is made at all — a fork or a local build measures nothing by default.
# VITE_PLAUSIBLE_DOMAIN=dotheory.org
#
# Optional tracker URL. Use the site-specific pa-XXXXX.js URL Plausible gives
# you for a new hosted site, or an HTTPS URL when self-hosting. The legacy
# hosted tracker remains the fallback for existing Plausible sites.
# VITE_PLAUSIBLE_SRC=https://plausible.io/js/pa-XXXXX.js

# If using the default (relative paths):
# VITE_API_BASE_URL=/api

# For production:
# VITE_API_BASE_URL=https://your-production-backend.com/api
