# Production environment template for Google Cloud Run.
# Store every value below as a Google Cloud Secret Manager secret, then reference
# it in the Cloud Run deploy step via --set-secrets. Never commit real values.

ORCHESTRATOR_SERVICE_NAME=dot-orchestrator
ORCHESTRATOR_SERVICE_PORT=8000
ORCHESTRATOR_ENVIRONMENT=production
ORCHESTRATOR_LOG_LEVEL=INFO

# Comma-separated list of allowed frontend origins (no trailing slash).
# Example: https://dot.example.com,https://www.dot.example.com
ORCHESTRATOR_CORS_ORIGINS=["https://your-domain.com"]

# Auth — must be jwt in production; local_header is rejected at startup.
ORCHESTRATOR_AUTH_ENABLED=true
ORCHESTRATOR_AUTH_MODE=jwt
ORCHESTRATOR_SERVICE_AUTH_SECRET=<generate: openssl rand -hex 32>
ORCHESTRATOR_JWT_ISSUER=dot-bff
ORCHESTRATOR_JWT_AUDIENCE=dot-orchestrator

# Postgres — Cloud SQL (Postgres 16) via private IP or Cloud SQL Auth Proxy.
# asyncpg driver required.
ORCHESTRATOR_DATABASE_URL=postgresql+asyncpg://user:password@/dot_orchestrator?host=/cloudsql/PROJECT:REGION:INSTANCE

# Redis — Memorystore for Redis (VPC-peered) or Redis Cloud.
ORCHESTRATOR_REDIS_URL=redis://10.x.x.x:6379

# Object store — Google Cloud Storage via S3-compatible interoperability API,
# or Cloudflare R2. Both work with the existing S3ObjectStore adapter.
# GCS interop: endpoint = https://storage.googleapis.com
# R2: endpoint = https://<account-id>.r2.cloudflarestorage.com
ORCHESTRATOR_OBJECT_STORE_BACKEND=s3
ORCHESTRATOR_OBJECT_STORE_BUCKET=dot-orchestrator-prod
ORCHESTRATOR_OBJECT_STORE_ENDPOINT=https://storage.googleapis.com
ORCHESTRATOR_AWS_ACCESS_KEY_ID=<gcs-hmac-access-key>
ORCHESTRATOR_AWS_SECRET_ACCESS_KEY=<gcs-hmac-secret>
ORCHESTRATOR_AWS_REGION=auto

# Sentry (optional but strongly recommended for production)
ORCHESTRATOR_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# Support plane (ADR-0012). Leave blank to keep contributions closed; the
# surface hides itself when the publishable key is empty. The webhook secret is
# required for the ledger to accept any event at all.
ORCHESTRATOR_STRIPE_SECRET_KEY=<stripe-secret-key>
ORCHESTRATOR_STRIPE_PUBLISHABLE_KEY=<stripe-publishable-key>
ORCHESTRATOR_STRIPE_WEBHOOK_SECRET=<stripe-webhook-signing-secret>

# ── GitHub Actions variables (set in repo Settings → Variables, not secrets) ──
# GCP_PROJECT_ID   = your-gcp-project-id
# GCP_REGION       = us-central1
# AR_REPO          = dot-orchestrator   (Artifact Registry repo name)
#
# ── GitHub Actions secrets ────────────────────────────────────────────────────
# GCP_WORKLOAD_IDENTITY_PROVIDER = projects/NUMBER/locations/global/workloadIdentityPools/POOL/providers/PROVIDER
# GCP_SERVICE_ACCOUNT            = deploy-sa@your-project.iam.gserviceaccount.com
