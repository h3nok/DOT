ORCHESTRATOR_SERVICE_NAME=dot-orchestrator
ORCHESTRATOR_SERVICE_PORT=8000
ORCHESTRATOR_ENVIRONMENT=development
ORCHESTRATOR_LOG_LEVEL=INFO
ORCHESTRATOR_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5000","http://127.0.0.1:5000"]

ORCHESTRATOR_AUTH_ENABLED=true
ORCHESTRATOR_AUTH_MODE=local_header
# Required while auth is enabled. Generate with: openssl rand -hex 32
ORCHESTRATOR_SERVICE_AUTH_SECRET=
ORCHESTRATOR_JWT_ISSUER=dot-bff
ORCHESTRATOR_JWT_AUDIENCE=dot-orchestrator

ORCHESTRATOR_DATABASE_URL=postgresql+asyncpg://dot:dot@localhost:5432/dot_orchestrator
ORCHESTRATOR_REDIS_URL=redis://localhost:6379/0
ORCHESTRATOR_OBJECT_STORE_BACKEND=filesystem
ORCHESTRATOR_OBJECT_STORE_ENDPOINT=http://localhost:9000
ORCHESTRATOR_OBJECT_STORE_BUCKET=dot-orchestrator-local
ORCHESTRATOR_LOCAL_OBJECT_STORE_ROOT=.data/orchestrator-objects
